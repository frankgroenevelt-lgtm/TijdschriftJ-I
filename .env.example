# =============================================================
#  Environment variables voor de Supabase Edge Functions.
#  Kopieer dit bestand naar .env (lokaal) of stel ze in als
#  Supabase Secrets (productie). Zet NOOIT echte waarden in git.
# =============================================================

# --- Supabase (Settings -> API in je Supabase project) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (service account) ---
# De VOLLEDIGE inhoud van credentials.json als één regel JSON.
# Tip: zorg dat \n in de private_key behouden blijft (of als letterlijke \n).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=1jY4mEndb-xKQaBATZu1KthhElwdJaudZ

# --- Resend e-mail (https://resend.com) ---
RESEND_API_KEY=
# Afzender. Gebruik onboarding@resend.dev om te testen, of een eigen
# geverifieerd domein in productie. Formaat: "Naam <mail@domein.nl>"
RESEND_FROM=Tijdschrift J&I <onboarding@resend.dev>
NOTIFICATION_EMAIL=frankgroenevelt@gmail.com
